# ─── Server ────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Supabase (Postgres + pgvector + Storage + Auth) ───────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_STORAGE_BUCKET=kosher-knowledge

# ─── AI providers ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4000

OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

PERPLEXITY_API_KEY=pplx-...
PERPLEXITY_MODEL=sonar-pro

# ─── GoHighLevel ──────────────────────────────────────────
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_WEBHOOK_SECRET=

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALG=HS256
JWT_TTL_HOURS=24

# ─── Brand defaults (mirrored to brand_config on first boot) ──
BRAND_NAME=KosherLending
BRAND_NMLS=320841
BRAND_WEBSITE=KosherLending.com
BRAND_CREATOR=Jeffrey Ben-Davis
BRAND_COMPLIANCE=Jeffrey Ben-Davis | NMLS #320841 | KosherLending.com | Equal Housing Lender
EXCLUDED_STATES=NY

# ─── Feature flags ────────────────────────────────────────
# Set to false to bypass Supabase writes on /api/generate
# (returns the generated package to the UI but does not persist it).
# Use when the Supabase project is read-only / over quota.
PERSIST_GENERATED_CONTENT=true
